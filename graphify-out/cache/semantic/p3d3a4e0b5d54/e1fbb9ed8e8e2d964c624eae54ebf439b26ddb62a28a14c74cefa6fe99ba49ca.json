utor": null}, {"id": "explainability_machinelearning_mit_bih_arrhythmia_database", "label": "MIT-BIH Arrhythmia Database", "file_type": "concept", "rationale": "Public, cardiologist-annotated database (47 subjects, 360 Hz, 2 channels, 11-bit) widely used for time-series classification research; stored in folder 'mitbih'.", "source_file": "explainability_machineLearning.pdf", "source_location": "p2", "source_url": "https://physionet.org/content/mitdb/1.0.0/", "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_wfdb_package", "label": "WFDB Python package (waveform-database)", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p2", "source_url": "https://www.physionet.org/content/wfdb-python/3.3.0/", "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_eight_beat_classes", "label": "Eight arrhythmia beat classes (N, L, R, V, A, F, f, /) and class IDs 1-8", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p2-3, p6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_dual_channel_beat_extraction", "label": "Dual-channel beat extraction and stacking", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_r_peak_centering", "label": "R-peak centering of beats", "file_type": "rationale", "rationale": "Centering R-peaks with equal samples either side gives every beat the same length and consistent alignment.", "source_file": "explainability_machineLearning.pdf", "source_location": "p3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_beat_standardization", "label": "Beat standardization", "file_type": "rationale", "rationale": "Standardizing every beat avoids irregular amplitudes between signals.", "source_file": "explainability_machineLearning.pdf", "source_location": "p3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_class_imbalance", "label": "Class imbalance in MIT-BIH (dominant N beats)", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_bootstrap_resampling", "label": "Bootstrap resampling of training beats (scikit-learn resample)", "file_type": "rationale", "rationale": "Up/down-sampling each class to the mean count of abnormal classes (with replacement) addresses class imbalance; handout reports 3990 samples/class (beat split) and 25789/class (patient split).", "source_file": "explainability_machineLearning.pdf", "source_location": "p5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_beat_holdout_protocol", "label": "Beat hold-out validation protocol (75/25 split)", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_patient_holdout_protocol", "label": "Patient hold-out (Leave Groups Out) protocol: test patients 104, 113, 119, 208, 210", "file_type": "rationale", "rationale": "Testing on unseen patients avoids data leakage from same-patient beat morphology; trade-off is that test set lacks L, R and A classes.", "source_file": "explainability_machineLearning.pdf", "source_location": "p5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_data_leakage", "label": "Data leakage / data bleeding between train and test beats", "file_type": "rationale", "rationale": "Beats from the same patient share morphology (electrode placement, conditions, medication), so random beat shuffling puts near-duplicates in train and test, inflating results.", "source_file": "explainability_machineLearning.pdf", "source_location": "p5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_one_hot_label_encoding", "label": "One-hot encoding of heartbeat class labels", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_data_loading_requirement", "label": "Load hold-out CSVs into NumPy arrays (e.g. 31920x275 train, 37863x275 test)", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_svm_classifier", "label": "Support Vector Machine (SVC) beat classifier", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p6-7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_evaluation_metrics_function", "label": "Evaluation function: accuracy, precision, recall, F1, confusion matrix", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p6-7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_permutation_feature_importance", "label": "Permutation feature importance", "file_type": "concept", "source_file": "explainability_machineLearning.pdf", "source_location": "p7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainability_machinelearning_permfit_algo