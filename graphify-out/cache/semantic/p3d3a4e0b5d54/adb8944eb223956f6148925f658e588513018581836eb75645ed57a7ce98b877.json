{"nodes": [{"id": "figures_ecg_data_preprocessed", "label": "Preprocessed ECG Beat Examples (8 classes)", "file_type": "image", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "3x3 grid (8 panels) showing one preprocessed, R-peak-centred heartbeat per MIT-BIH class (N, L, R, V, A, F, f, /), labelled 'Class: X, Number: k' (k=1..8 = class index). x-axis 0-~275 samples, y-axis standardised amplitude (~-4 to 7). Demonstrates distinct morphologies the classifiers must separate."}, {"id": "figures_ecg_data_preprocessed_beat_segmentation_window", "label": "Fixed-length R-peak-centred beat window (~275 samples)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every beat is aligned with its QRS peak near sample ~138, so each sample index is a comparable feature for SVM/Random Forest."}, {"id": "figures_ecg_data_preprocessed_amplitude_standardisation", "label": "Per-beat amplitude standardisation (z-score)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Baselines sit near 0 and peaks reach several units, consistent with z-score normalisation removing inter-patient amplitude differences."}, {"id": "figures_ecg_data_preprocessed_first_sample_artifact", "label": "Spike at sample 0 (edge artifact)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "N, L, R, V, A and F beats show an abrupt jump at index 0 that drops to baseline immediately; likely a filtering/segmentation boundary artifact rather than physiology. Could act as a spurious feature."}, {"id": "figures_ecg_data_preprocessed_class_n", "label": "Class N (Normal beat)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Narrow tall QRS (~7), small P wave, flat baseline."}, {"id": "figures_ecg_data_preprocessed_class_l", "label": "Class L (Left bundle branch block beat)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Wide, notched QRS followed by deep negative deflection and slow recovery."}, {"id": "figures_ecg_data_preprocessed_class_r", "label": "Class R (Right bundle branch block beat)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Double-peaked (rSR') QRS followed by a deep wide trough to ~-3."}, {"id": "figures_ecg_data_preprocessed_class_v", "label": "Class V (Premature ventricular contraction)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Broad monophasic QRS (~5) without sharp Q/S dips."}, {"id": "figures_ecg_data_preprocessed_class_a", "label": "Class A (Atrial premature beat)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Narrow QRS very similar to N; differs mainly in timing/P-wave, hard to separate from N by morphology alone."}, {"id": "figures_ecg_data_preprocessed_class_f_fusion_ventricular", "label": "Class F (Fusion of ventricular and normal beat)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Small pre-wave then tall QRS (~5) with S dip; intermediate between N and V."}, {"id": "figures_ecg_data_preprocessed_class_f_fusion_paced", "label": "Class f (Fusion of paced and normal beat)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Clean baseline, sharp positive peak (~5) followed by deep negative spike (~-4), biphasic."}, {"id": "figures_ecg_data_preprocessed_class_paced", "label": "Class / (Paced beat)", "file_type": "concept", "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Small pacing spike then wide deep negative complex (~-2.6) and broad positive T-wave; very smooth, low-noise trace."}], "edges": [{"source": "figures_ecg_data_preprocessed", "target": "figures_ecg_data_preprocessed_class_n", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "weight": 1.0}, {"source": "figures_ecg_data_preprocessed", "target": "figures_ecg_data_preprocessed_class_l", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "weight": 1.0}, {"source": "figures_ecg_data_preprocessed", "target": "figures_ecg_data_preprocessed_class_r", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "figures/ecg_data_preprocessed.jpg", "source_location": null, "weight": 1.0}, {"source": "figures_ecg_data_preprocessed", "target": "figures_ecg_data_preprocessed_class_v", "relation": "references", "confidence": "EXTRACTED", "confide