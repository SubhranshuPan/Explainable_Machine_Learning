{"nodes": [{"id": "ml_interpretability_part2__1__lime_shap_lecture_slides", "label": "ML Interpretability Part 2 Lecture Slides (LIME and SHAP)", "file_type": "document", "source_file": "ML_interpretability-part2 (1).pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ml_interpretability_part2__1__lime", "label": "Local Interpretable Model-agnostic Explanations (LIME)", "file_type": "rationale", "source_file": "ML_interpretability-part2 (1).pdf", "source_location": "p3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locally faithful explanations from a locally linear surrogate model weighted by a proximity measure; accurate while keeping model flexibility, understandable by non-experts, and cheap to switch models. Gives qualitative understanding of input-response relations."}, {"id": "ml_interpretability_part2__1__proximity_measure", "label": "Proximity Measure (Local Weighting Kernel)", "file_type": "concept", "source_file": "ML_interpretability-part2 (1).pdf", "source_location": "p5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ml_interpretability_part2__1__local_linear_surrogate_model", "label": "Locally Linear Surrogate Model", "file_type": "concept", "source_file": "ML_interpretability-part2 (1).pdf", "source_location": "p3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ml_interpretability_part2__1__lime_tabular_explainer", "label": "LIME Tabular Explainer", "file_type": "concept", "source_file": "ML_interpretability-part2 (1).pdf", "source_location": "p8", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ml_interpretability_part2__1__lime_text_explainer", "label": "LIME Text Explainer", "file_type": "concept", "source_file": "ML_interpretability-part2 (1).pdf", "source_location": "p8", "source_url": null, "captured_at": null, "au