{"nodes": [{"id": "figures_cm_svm_beat", "label": "SVM Confusion Matrix \u2013 Beat Hold-out", "file_type": "image", "source_file": "figures/cm_svm_beat.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Row-normalised 8x8 confusion matrix (rows = true class, columns = predicted) for the SVM classifier under the beat hold-out (random 75/25) protocol on MIT-BIH beats N, L, R, V, A, F, f, /. Diagonal recalls: N 0.96, L 1.00, R 0.99, V 0.96, A 0.92, F 0.92, f 0.94, / 0.99. Near-perfect per-class recall overall."}, {"id": "figures_cm_svm_beat_svm_classifier", "label": "SVM Classifier", "file_type": "concept", "source_file": "figures/cm_svm_beat.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_cm_svm_beat_beat_hold_out_protocol", "label": "Beat Hold-out Protocol (random 75/25 split)", "file_type": "concept", "source_file": "figures/cm_svm_beat.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Random beat-level split lets beats from the same patient appear in both train and test, so the high recalls shown here likely overstate generalisation compared with the patient hold-out protocol."}, {"id": "figures_cm_svm_beat_row_normalised_confusion_matrix", "label": "Row-normalised Confusion Matrix (per-class recall)", "file_type": "concept", "source_file": "figures/cm_svm_beat.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_cm_svm_beat_mit_bih_beat_classes", "label": "MIT-BIH 8 Beat Classes (N, L, R, V, A, F, f, /)", "file_type": "concept", "source_file": "figures/cm_svm_beat.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_cm_svm_beat_a_to_n_confusion", "label": "Atrial premature (A) beats misclassified as