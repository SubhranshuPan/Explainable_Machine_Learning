{"nodes": [{"id": "figures_ecg_data_beats_per_class", "label": "Annotation Distribution for all Classes in the Dataset (bar chart)", "file_type": "image", "source_file": "figures/ecg_data_beats_per_class.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Bar chart of raw MIT-BIH beat annotation counts across all 15 symbols before class filtering: N=75052, L=8075, R=7259, V=7130, /=7028, A=2546, f=982, F=803, j=229, a=150, E=106, J=83, Q=33, e=16, S=2."}, {"id": "figures_ecg_data_beats_per_class_mit_bih_class_imbalance", "label": "MIT-BIH Beat Class Imbalance", "file_type": "concept", "source_file": "figures/ecg_data_beats_per_class.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal (N) beats are about 75k, roughly 10x any other class. Several symbols (j, a, E, J, Q, e, S) have fewer than 250 samples. This skew is likely why the project keeps only 8 classes (N, L, R, V, A, F, f, /) and resamples the training data."}, {"id": "figures_ecg_data_beats_per_class_mit_bih_annotation_symbols", "label": "MIT-BIH Beat Annotation Symbols (15 types)", "file_type": "concept", "source_file": "figures/ecg_data_beats_per_class.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "figures_ecg_data_beats_per_class_eight_class_selection", "label": "Eight-Class Selection (N, L, R, V, A, F, f, /)", "file_type": "rationale", "source_file": "figures/ecg_data_beats_per_class.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 8 retained classes are the ones with roughly 800 or more beats (F=803 is the smallest). The 7 rare symbols, each under 250 beats, are dropped."}], "edges": [{"source": "figures_ecg_data_beats_per_class", "target": "figures_ecg_data_beats_per_class_mit_bih_annotation_symbols", "relat