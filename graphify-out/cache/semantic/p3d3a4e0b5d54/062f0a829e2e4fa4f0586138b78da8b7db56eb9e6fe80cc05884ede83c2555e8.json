{"nodes": [{"id": "explainabilitymachinelearning__2__explainability_lecture_slides", "label": "Explainability in Machine Learning Lecture Slides", "file_type": "document", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__fani_deligianni", "label": "Dr. Fani Deligianni (University of Glasgow)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__explainable_models", "label": "Explainable Models", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explainable models give knowledge of which input factors affect the output and how much they affect the decision, even when the model itself is not transparent."}, {"id": "explainabilitymachinelearning__2__interpretable_models", "label": "Interpretable / Transparent Models", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model is readily understandable, gives a direct explanation, lets one know what each node represents and determine cause and effect."}, {"id": "explainabilitymachinelearning__2__representation_learning_explanation", "label": "Representation Learning Explanation (Latent Factors)", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explain a model by knowing what each node represents, the latent factors behind the decision, and how important each node is to performance."}, {"id": "explainabilitymachinelearning__2__decision_trees", "label": "Decision Trees", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inherently interpretable: each node is clear, the whole decision process is easy to visualize and explain to non-specialists, and results can be traced to each node."}, {"id": "explainabilitymachinelearning__2__linear_regression", "label": "Linear Regression", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__logistic_regression", "label": "Logistic Regression", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__random_forests", "label": "Random Forests", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__neural_networks", "label": "Neural Networks", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__convolutional_neural_networks", "label": "Convolutional Neural Networks", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__interpretability_spectrum", "label": "Interpretable vs Explainable Model Spectrum", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Models are placed on a spectrum: decision trees and linear/logistic regression are interpretable, random forests are a grey area, and neural networks/CNNs need post-hoc explanation."}, {"id": "explainabilitymachinelearning__2__interpretability_accuracy_tradeoff", "label": "Interpretability vs Accuracy Trade-off", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Going from linear regression, decision trees, KNN, random forests and SVMs to deep learning raises accuracy but lowers interpretability, which is why black-box models need explanation methods."}, {"id": "explainabilitymachinelearning__2__black_box_explanation_levels", "label": "Levels of Black-Box Explanation", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Black boxes can be explained via post-hoc surrogate models approximating their function, local/global importance of input factors, or representation learning of interpretable latent factors."}, {"id": "explainabilitymachinelearning__2__post_hoc_surrogate_models", "label": "Post-hoc Surrogate Model Explanations", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__arrieta_2020_xai", "label": "Arrieta et al. 2020 - Explainable Artificial Intelligence (XAI): Concepts, taxonomies, opportunities and challenges (Information Fusion)", "file_type": "paper", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__molnar_interpretable_ml_book", "label": "Molnar - Interpretable Machine Learning: A Guide for Making Black Box Models Explainable", "file_type": "paper", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__xai_taxonomy", "label": "Explainability Taxonomy (Local/Global, Model Agnostic/Specific, Modality Specific/Agnostic, Ad-hoc/Post-hoc)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p13", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__global_explanations", "label": "Global Explanations", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Give an overall view of the model by aggregating importance values over data points to show the model's top features and how each feature changes predictions."}, {"id": "explainabilitymachinelearning__2__model_agnostic_approaches", "label": "Model Agnostic Explanation Approaches", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred for model flexibility, explanation flexibility and representation flexibility: the same explainer works across any fitted model."}, {"id": "explainabilitymachinelearning__2__permutation_feature_importance", "label": "Permutation Feature Importance (PFI)", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Importance = drop in model score (e.g. accuracy) when one feature column is randomly shuffled K times, breaking its link to the target. Simple, global, model-agnostic, works for black-box estimators. Drawbacks: no in-depth view of decisions, ignores feature interactions, explains the whole dataset not individual samples, and adds randomness via reshuffling."}, {"id": "explainabilitymachinelearning__2__mi_2021_permfit", "label": "Mi et al. 2021 - Permutation-based identification of important biomarkers for complex diseases via machine learning models (Nature Communications)", "file_type": "paper", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__ribeiro_2016_model_agnostic_interpretability", "label": "Ribeiro et al. 2016 - Model-Agnostic Interpretability of Machine Learning (ICML WHI Workshop)", "file_type": "paper", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p22", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__electrocardiogram", "label": "Electrocardiogram (ECG)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__p_wave", "label": "P-wave (Atrial Depolarization)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__qrs_complex", "label": "QRS Complex (Ventricular Depolarization)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__t_wave", "label": "T-wave (Ventricular Repolarization)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__ecg_classification", "label": "ECG Classification with Machine Learning", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual ECG analysis is time-consuming and error prone and abnormalities may need continuous monitoring, motivating automated ML classification."}, {"id": "explainabilitymachinelearning__2__ecg_noise_interference", "label": "ECG Noise Interference (Baseline Wander, Electrode Contact, Motion Artifacts, Power Line)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p26", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__ecg_noise_filtering", "label": "ECG Noise Filtering", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p31", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__mit_bih_arrhythmia_database", "label": "MIT-BIH Arrhythmia Database", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public, cardiologist-annotated beat database: 47 subjects, 360 Hz, 11-bit over 10 mV, two channels; widely used for time-series classification."}, {"id": "explainabilitymachinelearning__2__arrhythmia_beat_classes", "label": "Eight Arrhythmia Beat Classes (N, L, R, V, A, F, f, /)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p28", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__ecg_data_preprocessing", "label": "ECG Data Pre-processing Pipeline", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__r_peak_annotation", "label": "R-peak Annotation / Centring", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__ecg_beat_segmentation", "label": "Segmentation into Individual ECG Beats", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__beat_standardization", "label": "Beat Standardization", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__class_imbalance_bootstrap_resampling", "label": "Class Imbalance Bootstrap Resampling", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal class is over-represented; bootstrap resampling with replacement up/down-samples each class to the mean count of the abnormal classes."}, {"id": "explainabilitymachinelearning__2__mark_1982_annotated_ecg_database", "label": "Mark RG et al. 1982 - An annotated ECG database for evaluating arrhythmia detectors (IEEE TBME)", "file_type": "paper", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__moody_2001_mit_bih_impact", "label": "Moody et al. 2001 - The impact of the MIT-BIH arrhythmia database (IEEE EMB Magazine)", "file_type": "paper", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__yola_2020_saliency_maps_ecg", "label": "Yola et al. 2020 - Improving ECG Classification Interpretability using Saliency Maps (IEEE BIBE)", "file_type": "paper", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p32", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__pfi_ecg_classification", "label": "PFI Applied to ECG Classification", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applying PFI to segment-level features reveals which part of the beat the classifier relies on; the model is expected to focus on morphological features (PR interval, QRS complex, ST segment)."}, {"id": "explainabilitymachinelearning__2__ecg_11_segment_slicing", "label": "11-Segment ECG Beat Slicing (Segment Averaging)", "file_type": "rationale", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each beat is divided into 11 slices whose data points are replaced by the slice average, so feature importance can be read per morphological segment: 1-4 PR interval, 5-7 QRS complex, 8-11 ST segment."}, {"id": "explainabilitymachinelearning__2__pr_interval", "label": "PR Interval (Segments 1-4)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__st_segment", "label": "ST Segment (Segments 8-11)", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p35", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__assessment_tasks", "label": "Coursework Assessment Tasks", "file_type": "document", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__holdout_split_validation", "label": "Holdout Splitting Validation", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__patient_holdout_validation", "label": "Leave-out / Patient Hold-out Validation Protocol", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "explainabilitymachinelearning__2__clustering_visualization", "label": "Clustering for Data Structure Visualization", "file_type": "concept", "source_file": "ExplainabilityMachineLearning (2).pdf", "source_location": "p37", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "explainabilitymachinelearning__2__explainability_lecture_slides", "target": "explainabilitymachinelearning__2__explainable_models", "relation": "references", "confidence": "EXTRACTED", "confidence_scor